    "line_029b2": {
      "type": "line",
      "speaker": "lillian",
      "text": "그럼요~! 안쪽에 테이블이 있어요~!",
      "next": "line_030"
    },
    "line_030": {
      "type": "line",
      "speaker": "lillian",
      "text": "테이블에서 잠시 기다려주세요~",
      "next": "null"
