    "line_029a2": {
      "type": "line",
      "speaker": "chaeon",
      "text": "먹으면 이상한 동물로 변하고 그런...",
      "effect": { "temperature": -1 },
      "next": "line_029a3"
    },
    "line_029a3": {
      "type": "line",
      "speaker": "lillian",
      "text": "에이 저를 뭘로 보시고!",
      "next": "line_029a4"
    },
    "line_029a4": {
      "type": "line",
      "speaker": "lillian",
      "text": "속는 셈 치고 한번 먹어봐요~",
      "next": "line_029a5"
    },
    "line_029a5": {
      "type": "line",
      "speaker": "chaeon",
      "text": "..............",
      "next": "line_029a6"
    },
    "line_029a6": {
      "type": "line",
      "speaker": "lillian",
      "text": "아니면 제가 먹어볼게요!",
      "next": "line_029a7"
    },
    "line_029a7": {
      "type": "line",
      "speaker": "chaeon",
      "text": [{ "text": "?!", "color": "#FF0509", "bold": true, "size": 18 }],
      "next": "line_029a8"
    },
    "line_029a8": {
      "type": "line",
      "speaker": "chaeon",
      "text": "저... 저기 괜찮으세요...?",
      "next": "line_029a9"
    },
    "line_029a9": {
      "type": "line",
      "speaker": "lillian",
      "text": "어때요? 이제 믿을 수 있겠죠?",
